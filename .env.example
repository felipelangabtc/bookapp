# =================================
# Database
# =================================
# LOCAL (Docker Postgres – run `pnpm docker:up` first):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/litapp?schema=public"
# PRODUCTION / STAGING (Neon example – uncomment and replace):
# DATABASE_URL="postgresql://user:pass@ep-cool-name-123456.us-east-2.aws.neon.tech/litapp?sslmode=require"

# =================================
# NextAuth.js
# =================================
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# =================================
# External Book APIs
# =================================
GOOGLE_BOOKS_API_KEY=""
OPEN_LIBRARY_BASE_URL="https://openlibrary.org"

# =================================
# Stripe
# =================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PRO="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# =================================
# Storage
# =================================
# Options: local | s3
STORAGE_PROVIDER="local"

# S3-compatible storage (only if STORAGE_PROVIDER=s3)
S3_ENDPOINT="https://s3.amazonaws.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="bookapp-storage"
S3_REGION="us-east-1"

# Local storage path (only if STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH="./uploads"

# =================================
# TTS (Text-to-Speech)
# =================================
# Options: mock | openai | elevenlabs
TTS_PROVIDER="mock"

# OpenAI TTS (only if TTS_PROVIDER=openai)
OPENAI_API_KEY=""

# ElevenLabs TTS (only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=""

# =================================
# Translation
# =================================
# Options: mock | openai | deepl
TRANSLATION_PROVIDER="mock"

# DeepL (only if TRANSLATION_PROVIDER=deepl)
DEEPL_API_KEY=""

# =================================
# Email (for verification/password reset)
# =================================
# Options: mock | smtp | resend
EMAIL_PROVIDER="mock"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="noreply@bookapp.com"

# =================================
# Rate Limiting
# =================================
RATE_LIMIT_ENABLED="true"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =================================
# Application Settings
# =================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="debug"

# =================================
# Free/Pro Plan Limits
# =================================
FREE_AUDIOBOOK_GENERATIONS_PER_MONTH="5"
PRO_AUDIOBOOK_GENERATIONS_PER_MONTH="100"
